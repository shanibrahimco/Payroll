# Copy this file to .env on the server and put your domain below.
PAYROLL_DOMAIN=payroll.example.com

# Where the live data and the daily backups are kept on the server
PAYROLL_DATA_PATH=/srv/payroll/data
PAYROLL_BACKUP_PATH=/srv/payroll/backups

# How many days of daily backups to keep on the server
BACKUP_KEEP_DAYS=14
