# Allowlist: everything is ignored unless it is named below.
# Databases, backups, bank exports, uploads, staff workbooks, .venv and .vscode stay on this computer.
*
!.gitignore
!README.md
!requirements.txt
!app.py
!config.py
!database.py
!api/
!api/**
!auth/
!auth/**
!attendance/
!attendance/**
!common/
!common/**
!leaves/
!leaves/**
!loans/
!loans/**
!notifications/
!notifications/**
!payroll/
!payroll/**
!staff/
!staff/**
!timesheets/
!timesheets/**
!travel/
!travel/**
!web/
!web/**
!tests/
!tests/**
__pycache__/
*.pyc
